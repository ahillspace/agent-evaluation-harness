{
  "name": "agent-evaluation-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "dev:web": "vite --host 127.0.0.1",
    "cli": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json && vite build",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=4",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:architecture": "node scripts/architecture-check.mjs",
    "hooks:install": "tsx scripts/local-ci.ts install",
    "validate": "npm run format:check && npm run check:architecture && npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "quickjs-emscripten": "^0.31.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@types/node": "^22.15.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.1",
    "globals": "^16.0.0",
    "happy-dom": "^20.14.6",
    "prettier": "^3.5.3",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.1",
    "vite": "^6.3.5",
    "vitest": "^4.1.11"
  }
}
